# Copy to .env and fill in. Never commit the real file.

# --- Two different phone numbers -------------------------------------------
# This trips everyone up once, so it is worth being blunt about.
#
#   The SHOP's number   — registered with Meta, runs on the Cloud API, printed
#                         on the flyer and the contract. Customers message it.
#                         It is NOT set here: it lives in docs/playbook.md, so
#                         that one document stays the source of truth.
#
#   LUKAS's number      — the phone in his pocket. Approval requests arrive
#                         here and he replies APPROVE / DECLINE / BOOK / DUE.
#                         Set as OWNER_PHONE below.
#
# They must be different numbers. A number registered on the Cloud API can no
# longer be used in the normal WhatsApp app, and the agent cannot message
# itself — the server refuses to start if these two match.

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Meta app > WhatsApp > API Setup. Use a System User token, not the 24-hour
# temporary one, or the agent stops working tomorrow morning.
WHATSAPP_TOKEN=
# The ID under the shop's number in API Setup — a long number, not the phone
# number itself.
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > Settings > Basic > App Secret. Used to verify webhooks really
# come from Meta; without it anyone who found the URL could approve loans.
WHATSAPP_APP_SECRET=
# Any string you invent. Paste the same one into Meta's webhook setup form.
WHATSAPP_VERIFY_TOKEN=

# --- The shop ---------------------------------------------------------------
# Lukas's own WhatsApp. Local Namibian format is fine (081 282 3046).
OWNER_PHONE=
OWNER_NAME=Lukas
# Public HTTPS origin. Meta will not deliver webhooks to plain HTTP, and the
# contract signing link has to open on a customer's phone.
PUBLIC_BASE_URL=https://your-host.example

# --- Storage ----------------------------------------------------------------
# Generate once with: openssl rand -hex 32
# This key decrypts customer ID photos and the device PINs from the workbook.
# Losing it loses them; leaking it exposes customers' identity documents.
EPPIC_MEDIA_KEY=
EPPIC_DB_PATH=data/eppic.db
EPPIC_MEDIA_DIR=data/media

# --- Claude API (optional) --------------------------------------------------
# Without a key the agent still works; it just asks Lukas for the amount
# instead of suggesting one.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

PORT=8080

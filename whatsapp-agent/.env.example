# Copy to .env and fill in. Never commit the real file.

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# From the Meta app: WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret — used to verify webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same one into the Meta webhook setup form.
WHATSAPP_VERIFY_TOKEN=

# --- The shop ---------------------------------------------------------------
# Lukas's WhatsApp number. Local Namibian format is fine (081 282 3046).
OWNER_PHONE=081 282 3046
OWNER_NAME=Lukas

# --- Storage ----------------------------------------------------------------
# Generate once with: openssl rand -hex 32
# This key decrypts customer ID photos. Losing it loses the photos; leaking it
# exposes customers' identity documents. Keep it out of the repository.
EPPIC_MEDIA_KEY=
EPPIC_DB_PATH=data/eppic.db
EPPIC_MEDIA_DIR=data/media

# --- Claude API (optional) --------------------------------------------------
# Without a key the agent still works; it just asks Lukas for the amount
# instead of suggesting one.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

PORT=8080
